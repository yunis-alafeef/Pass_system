# ============================================================
# Pass System — Backend Environment Variables Template
# انسخ هذا الملف إلى .env وقم بتعديل القيم
# ============================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000
APP_NAME=Pass System API
API_PREFIX=api

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://pass_user:pass_password@localhost:5432/pass_system?schema=public"

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT / Auth ----------
JWT_ACCESS_SECRET=change_me_in_production_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---------- Security ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_LIMIT=100
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
SESSION_INACTIVITY_MINUTES=30

# ---------- Seat Hold ----------
SEAT_HOLD_TTL_SECONDS=900
MAX_SEATS_PER_HOLD=10

# ---------- OTP ----------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- SMS Gateway (Yemeni provider) ----------
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=PassSystem

# ---------- Email (SMTP) ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Pass System <no-reply@pass-system.ye>"

# ---------- WhatsApp ----------
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ---------- Payment Gateways ----------
# Kureimi / AmFlous
KUREIMI_BASE_URL=
KUREIMI_MERCHANT_ID=
KUREIMI_API_KEY=
KUREIMI_SECRET=
KUREIMI_WEBHOOK_SECRET=

# Tadamon (Mahfazati)
TADAMON_BASE_URL=
TADAMON_MERCHANT_ID=
TADAMON_API_KEY=
TADAMON_SECRET=

# Jawwal Pay
JAWWAL_BASE_URL=
JAWWAL_MERCHANT_ID=
JAWWAL_API_KEY=
JAWWAL_SECRET=

# Stripe (International cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment behaviour
PAYMENT_SUCCESS_RATE=1
PAYMENT_TIMEOUT_MS=30000

# ---------- Currency ----------
DEFAULT_CURRENCY=YER
USD_TO_YER=530
USD_TO_SAR=3.75
SAR_TO_YER=139

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
